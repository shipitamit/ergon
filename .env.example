# Copy to .env and fill in. Never commit .env.
# Used by the Studio proxy (server-side) and the SDK.
#
# Anthropic is the DEFAULT provider, so most people set only this one.
# Ergon is not Anthropic-only — set any key(s) you use (env var OR Studio →
# Settings → Keys, stored encrypted). Each agent picks its provider in the UI.

ANTHROPIC_API_KEY=sk-ant-...

# ── other providers (uncomment the ones you use) ──
# OPENAI_API_KEY=sk-...
# GEMINI_API_KEY=...                               # or GOOGLE_API_KEY

# Any OpenAI-compatible endpoint via OPENAI_BASE_URL — covers Ollama (local),
# Azure OpenAI, DeepSeek, Fireworks, Groq, Mistral, NVIDIA, OpenRouter,
# Perplexity, Together, vLLM, xAI (each also has a dedicated *_API_KEY):
# OPENAI_BASE_URL=http://localhost:11434/v1        # Ollama example
# GROQ_API_KEY=...        TOGETHER_API_KEY=...      MISTRAL_API_KEY=...
# DEEPSEEK_API_KEY=...    OPENROUTER_API_KEY=...    XAI_API_KEY=...

# AWS Bedrock:
# AWS_ACCESS_KEY_ID=...   AWS_SECRET_ACCESS_KEY=...   AWS_REGION=us-east-1

# Studio accounts tier (optional):
# SESSION_SECRET=change-me-to-a-long-random-string
