{
  "name": "ergon-studio",
  "private": true,
  "version": "0.7.2",
  "license": "MIT",
  "type": "module",
  "scripts": {
    "dev": "concurrently -k \"npm:proxy\" \"vite\"",
    "proxy": "node server/proxy.mjs",
    "build": "vite build",
    "start": "NODE_ENV=production node server/proxy.mjs",
    "preview": "vite preview",
    "enable-accounts": "npm install better-sqlite3 bcryptjs",
    "enable-sso": "npm install jose",
    "test:auth": "node server/auth.test.mjs",
    "enable-browser": "npm i playwright && npx playwright install chromium",
    "test:codegen": "node src/codegen.test.mjs",
    "test:proxy": "node server/proxy.test.mjs",
    "test": "npm run test:codegen && npm run test:proxy && npm run test:backends && npm run test:secrets && npm run test:ops && npm run test:providers && npm run test:orgs && npm run test:audit && npm run test:sso && npm run test:apikeys && npm run test:runs && npm run test:metrics && npm run test:rollups && npm run test:search && npm run test:alerts && npm run test:alert-delivery && npm run test:approvals && npm run test:eval-score && npm run test:eval && npm run test:eval-run && npm run test:budgets && npm run test:deployments && npm run test:hosting && npm run test:gateway && npm run test:governance && npm run test:collab && npm run test:presence && npm run test:versions && npm run test:cron && npm run test:triggers && npm run test:cryptobox && npm run test:connectors && npm run test:oauthconn && npm run test:connections && npm run test:auth",
    "test:backends": "node server/backends.test.mjs",
    "enable-scale": "npm i pg redis",
    "test:secrets": "node server/secrets.test.mjs",
    "migrate": "node server/migrate_cli.mjs",
    "migrate:status": "node server/migrate_cli.mjs --status",
    "test:ops": "node server/ops.test.mjs",
    "test:providers": "node server/providers.test.mjs",
    "test:orgs": "node server/orgs.test.mjs",
    "test:audit": "node server/audit.test.mjs",
    "test:sso": "node server/oidc.test.mjs && node server/sso-db.test.mjs",
    "test:apikeys": "node server/apikeys.test.mjs",
    "test:runs": "node server/runs.test.mjs",
    "test:metrics": "node server/metrics.test.mjs",
    "test:rollups": "node server/rollups.test.mjs",
    "test:search": "node server/search.test.mjs",
    "test:alerts": "node server/alerts.test.mjs",
    "test:alert-delivery": "node server/alert-delivery.test.mjs",
    "test:approvals": "node server/approvals.test.mjs",
    "test:eval-score": "node server/eval-score.test.mjs",
    "test:eval": "node server/eval.test.mjs",
    "test:eval-run": "node server/eval-run.test.mjs",
    "test:budgets": "node server/budgets.test.mjs",
    "test:deployments": "node server/deployments.test.mjs",
    "test:hosting": "node server/hosting.test.mjs",
    "test:gateway": "node server/gateway.test.mjs",
    "test:governance": "node server/governance.test.mjs",
    "test:collab": "node server/collab.test.mjs",
    "test:presence": "node server/presence.test.mjs",
    "test:versions": "node server/versions.test.mjs",
    "test:cron": "node server/cron.test.mjs",
    "test:triggers": "node server/triggers.test.mjs",
    "test:cryptobox": "node server/cryptobox.test.mjs",
    "test:connectors": "node server/connectors.test.mjs",
    "test:oauthconn": "node server/oauth-connections.test.mjs",
    "test:connections": "node server/connections.test.mjs",
    "test:pg": "node server/pg_smoke.mjs",
    "backup": "node server/backup_cli.mjs",
    "backup:list": "node server/backup_cli.mjs --list",
    "restore": "node server/backup_cli.mjs --restore"
  },
  "dependencies": {
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@vitejs/plugin-react": "^4.3.4",
    "concurrently": "^9.1.0",
    "vite": "^6.0.5"
  },
  "optionalDependencies": {
    "better-sqlite3": "^11.3.0",
    "bcryptjs": "^2.4.3",
    "playwright": "^1.40.0",
    "pg": "^8.11.0",
    "redis": "^4.6.0",
    "jose": "^5.9.6",
    "@aws-sdk/client-secrets-manager": "^3.500.0",
    "@google-cloud/secret-manager": "^5.0.0",
    "@azure/keyvault-secrets": "^4.8.0",
    "@azure/identity": "^4.0.0"
  }
}
