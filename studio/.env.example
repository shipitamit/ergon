# Copy to .env (or export in your shell) before running the proxy.
# Anthropic is the DEFAULT provider — set only the key(s) you use. Keys can also
# be added in the Studio (Settings → Keys, encrypted); those take precedence.
ANTHROPIC_API_KEY=sk-ant-...

# OpenAI, or ANY /chat/completions-compatible endpoint via OPENAI_BASE_URL:
# Azure OpenAI, DeepSeek, Fireworks, Groq, Mistral, NVIDIA, OpenRouter,
# Perplexity, Together, vLLM, xAI, or local Ollama. Each also has a dedicated
# *_API_KEY the proxy recognizes (e.g. GROQ_API_KEY, TOGETHER_API_KEY, …).
OPENAI_API_KEY=sk-...
OPENAI_BASE_URL=https://api.openai.com/v1         # e.g. http://localhost:11434/v1 for Ollama

# Google Gemini:
GEMINI_API_KEY=AIza...                            # or GOOGLE_API_KEY

# AWS Bedrock (native SigV4 in the SDK/export):
# AWS_ACCESS_KEY_ID=...  AWS_SECRET_ACCESS_KEY=...  AWS_REGION=us-east-1

PORT=8787

# Collaboration tier (optional; enable with: npm run enable-accounts)
# ERGON_DB=./ergon.db   # SQLite file location (default shown)

# Enterprise SSO (optional; OIDC authorization-code + PKCE).
# Install the verifier once with: npm run enable-sso
# All three below are required to turn SSO on; the rest are optional.
# OIDC_ISSUER=https://accounts.example.com
# OIDC_CLIENT_ID=your-client-id
# OIDC_REDIRECT_URI=https://studio.example.com/api/auth/sso/callback
# OIDC_CLIENT_SECRET=         # confidential clients only; omit for public + PKCE
# OIDC_SCOPE=openid email profile
# OIDC_STATE_SECRET=          # HMAC key for the login-state cookie (set for multi-instance)
